# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789
ALLOWED_CHATS=-1001234567890,-1009876543210

# AI API Keys (Для безкоштовної роботи заповніть лише GEMINI_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Model Settings
DEFAULT_ROLE=mops
DEFAULT_ROUTER_MODE=auto
MAX_CONTEXT_MESSAGES=15
TEMPERATURE=0.92
DATABASE_PATH=data/bot_database.sqlite
LOG_LEVEL=INFO
